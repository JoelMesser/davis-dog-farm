---
/**
 * Live list of adoptable dogs, rendered in the browser by ShelterManager's
 * embed script.
 *
 * Why a third-party embed instead of our own markup:
 *   The rescue manages its animals in ShelterManager (sheltermanager.com).
 *   The embed script it serves contains the current animal data, so when
 *   staff add, update or adopt out a dog, this page reflects it on the next
 *   visit, with no rebuild or deploy and no developer involved. That
 *   property is the whole point. Resist the temptation to fetch the data at
 *   build time and render it ourselves: the list would go stale between
 *   deploys, and ShelterManager's JSON API requires credentials anyway.
 *
 * The cost of that choice is that we don't own the markup. This component
 * contains everything needed to make someone else's HTML behave like ours:
 *   1. Configuration, read by the embed from global variables.
 *   2. A post-render patch for accessibility and performance gaps.
 *   3. Global styles that restyle its markup to match the site.
 * If ShelterManager changes its output and the list breaks, all the fixes
 * belong in this one file.
 */
import { adoptablesPageUrl, adoptablesScriptUrl, petfinderUrl } from "../data/site";
---

<div id="asm3-adoptables" class="adoptables">
  <p class="muted">Loading our dogs…</p>
</div>
<noscript>
  <p>
    <a href={adoptablesPageUrl}>See the list of adoptable dogs</a>
  </p>
</noscript>
<p class="small muted note">
  You can also find our dogs on <a href={petfinderUrl}>Petfinder</a>.
</p>

<!--
  is:inline tells Astro to emit these scripts exactly as written, in this order.
  Astro's normal bundling would turn them into deferred modules, and the
  configuration must exist before the embed script executes.
-->
<script is:inline>
  // 1. Configuration. The embed reads these as globals, by these exact names.
  Object.assign(window, {
    // Which filter dropdowns to show. Also controls the tags under each name.
    asm3_adoptable_filters: "agegroup sex",
    // Open a dog's profile in a new tab instead of the embed's overlay.
    asm3_adoptable_iframe: false,
    // The default thumbnails are about 110×150px, too small for our cards.
    // The full-size photos are heavy, which is why step 2 lazy-loads them.
    asm3_adoptable_fullsize_images: true,
    asm3_adoptable_translations: {
      "(any age)": "Any age",
      "(any sex)": "Any sex",
      "No results": "No dogs match those filters.",
    },
    // Called once per dog; the returned HTML is appended to the card.
    // BREEDNAME comes from an external system, so escape it before it goes
    // into innerHTML. Assigning textContent and reading innerHTML back is a
    // dependency-free way to do that.
    asm3_adoptable_extra: function (animal) {
      var escape = document.createElement("div");
      escape.textContent = animal.BREEDNAME || "";
      return '<div class="asm3-adoptable-breed">' + escape.innerHTML + "</div>";
    },
  });
</script>
<script is:inline src={adoptablesScriptUrl}></script>
<script is:inline>
  // 2. Post-render patch. The embed renders on window load and again on every
  //    filter change, replacing its markup each time, so a MutationObserver
  //    (not a one-off fix-up) is what keeps these fixes applied.
  (function () {
    var host = document.getElementById("asm3-adoptables");
    // The embed's <select>s have no labels: a critical axe violation, since a
    // screen reader would announce them as just "combo box".
    var labels = {
      "asm3-select-agegroup": "Filter by age",
      "asm3-select-sex": "Filter by sex",
    };

    new MutationObserver(function () {
      Object.keys(labels).forEach(function (id) {
        var select = document.getElementById(id);
        if (select && !select.hasAttribute("aria-label")) {
          select.setAttribute("aria-label", labels[id]);
        }
      });

      // :not([loading]) makes this idempotent: each photo is patched once.
      host.querySelectorAll("img.asm3-adoptable-thumbnail:not([loading])").forEach(function (img) {
        // Empty alt: the dog's name is the visible text of the same link, so
        // repeating it as alt text makes screen readers say it twice.
        img.alt = "";
        img.loading = "lazy";
        img.decoding = "async";
      });
    }).observe(host, { childList: true, subtree: true });
  })();
</script>

<!--
  3. Styles. is:global is required: Astro's default scoped styles only match
  elements written in this component's template, and the embed creates its
  elements at runtime.
-->
<style is:global>
  /*
   * These selectors target ShelterManager's undocumented asm3-* classes and
   * DOM order. The !important declarations are there only to beat inline
   * styles the embed writes; don't add more without the same reason.
   *
   * Card structure the embed produces (verified September 2026):
   *   .asm3-adoptable-item
   *     a.asm3-adoptable-link
   *       div > img.asm3-adoptable-thumbnail
   *       .asm3-adoptable-name
   *     .asm3-adoptable-tagline > span.asm3-adoptable-tag   (age group, sex)
   *     .asm3-adoptable-breed                               (from asm3_adoptable_extra)
   */

  /*
   * Reserve a full viewport while the list loads. The embed renders after
   * window load, and without this the sections below would jump down when it
   * arrives (Lighthouse measured CLS 0.195). Any shift now happens off-screen,
   * where it isn't counted.
   */
  .adoptables {
    min-height: 100svh;
  }

  .adoptables #asm3-adoptable-filters {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0 !important;
    text-align: left !important;
  }
  .adoptables select {
    padding: 0.55rem 0.8rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: 1rem var(--sans);
  }

  .adoptables .asm3-adoptable-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }
  .adoptables .asm3-adoptable-item {
    display: flex !important;
    flex-direction: column;
    max-width: none;
    padding: 0 !important;
    overflow: hidden;
    background: var(--board);
    border-radius: var(--radius);
    text-align: left !important;
  }
  .adoptables .asm3-adoptable-link {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .adoptables .asm3-adoptable-link > div:first-child {
    position: relative; /* anchor for the "Adoption pending" badge */
  }
  .adoptables .asm3-adoptable-thumbnail {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--line); /* placeholder tone while a lazy photo loads */
  }
  /* The embed adds .asm3-adoptable-reserved to dogs with an adoption in progress. */
  .adoptables .asm3-adoptable-reserved::after {
    content: "Adoption pending";
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    background: var(--hay);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .adoptables .asm3-adoptable-name {
    padding: 1rem 1.2rem 0.2rem;
    color: var(--denim-deep);
    font: 700 1.45rem/1.15 var(--slab);
  }
  .adoptables .asm3-adoptable-link:hover .asm3-adoptable-name {
    text-decoration: underline;
  }
  .adoptables .asm3-adoptable-breed {
    padding: 0 1.2rem;
    font-size: 1rem;
  }
  /*
   * In the DOM the tagline comes before the breed line. order: 3 moves it
   * visually to the bottom of the card (name, breed, then age and sex).
   */
  .adoptables .asm3-adoptable-tagline {
    order: 3;
    display: flex; /* flex drops the whitespace between tags, so the separator below controls spacing */
    flex-wrap: wrap;
    padding: 0.2rem 1.2rem 1.3rem;
    color: var(--muted);
    font-size: 1rem;
  }
  .adoptables .asm3-adoptable-tag + .asm3-adoptable-tag::before {
    content: ",\00a0"; /* comma + non-breaking space: "Puppy, Female" */
  }
  .adoptables .asm3-adoptable-no-results {
    grid-column: 1 / -1;
  }

  /* Two columns on phones, so visitors see more than one dog per screen. */
  @media (max-width: 40rem) {
    .adoptables .asm3-adoptable-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
    }
    .adoptables .asm3-adoptable-name {
      padding: 0.75rem 0.8rem 0.15rem;
      font-size: 1.2rem;
    }
    .adoptables .asm3-adoptable-breed {
      padding: 0 0.8rem;
      font-size: 0.9rem;
    }
    .adoptables .asm3-adoptable-tagline {
      padding: 0.15rem 0.8rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
